# Шаблон переменных окружения системного файла Docker Compose хаба. Копируй в .env и заполняй.
# .env не коммитится (см. .gitignore); этот файл — единственный источник имён ключей.
# Применяется к сервисам в системном файле Docker Compose через `env_file: .env`.

# Исполнитель первой готовой задачи из BACKLOG.md.
TASK_AGENT_MODEL_PROVIDER=ollama
TASK_AGENT_MODEL_BASE_URL=http://localhost:11434
TASK_AGENT_MODEL_API_KEY=
TASK_AGENT_MODEL_ID=<tool-capable-code-model>
TASK_AGENT_WORKSPACE=<absolute-path-to-program-workspace>
TASK_AGENT_METHODOLOGY_PATH=<absolute-path-to-methodology-repository>
TASK_AGENT_MAX_FILE_BYTES=200000
TASK_AGENT_COMMAND_TIMEOUT_SECONDS=120

# Брокер (адрес внутри сети Docker Compose — общий для всех сервисов)
BROKER_ADDR=broker:9092

# Пин контракта, на котором работает программа (хаб поддерживает).
CONVENTIONS_PIN=v1

# Per-сервис конфиг (примеры; на сервис — свой набор; см. ARCHITECTURE сервис-репо).
# engine
ENGINE_LOG_LEVEL=info
ENGINE_HTTP_ADDR=:8080
# data
DATA_LOG_LEVEL=info
# manage
MANAGE_LOG_LEVEL=info
# collector
CCC_LOG_LEVEL=info
CCC_BROKER_ADDR=broker:9092
# clite (автономный компонент: пассивная цель, без брокера)
CLITE_TARGET_ID=demo-lite-1
CLITE_BIND_IP=0.0.0.0
CLITE_LOG_LEVEL=info
# ui (интерфейс: URL presentation-эндпоинтов gateway)
VITE_API_GATEWAY=http://gateway:8080/v1