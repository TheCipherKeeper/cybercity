# Шаблон переменных окружения системного compose хаба. Копируй в .env и заполняй.
# .env не коммитится (см. .gitignore); этот файл — единственный источник имён ключей.
# Применяется к сервисам в системном compose через env_file: .env.

# Брокер (адрес внутри сети compose — общий для всех сервисов)
BROKER_ADDR=broker:9092

# Пин контракта, на котором работает программа (хаб поддерживает).
CONVENTIONS_PIN=v1

# Per-сервис конфиг (примеры; на сервис — свой набор; см. ARCHITECTURE сервис-репо).
# engine
ENGINE_LOG_LEVEL=info
ENGINE_HTTP_ADDR=:8080
# data
DATA_LOG_LEVEL=info
# manage
MANAGE_LOG_LEVEL=info
# collector
CCC_LOG_LEVEL=info
CCC_BROKER_ADDR=broker:9092
# clite (stub-таргет: пассивная цель, без брокера)
CLITE_TARGET_ID=demo-lite-1
CLITE_BIND_IP=0.0.0.0
CLITE_LOG_LEVEL=info
# ui (интерфейс: URL presentation-эндпоинтов engine)
VITE_API_ENGINE=http://engine:8080/v1